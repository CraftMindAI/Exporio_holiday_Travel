# Copy to .env (local) or enter these in hPanel -> Node.js app -> Environment variables (production).
# Never commit the real .env.

# --- Hostinger MySQL (hPanel -> Databases -> MySQL Databases) ---
# Use the exact host, port, database name and username shown in hPanel.
# Special characters in the password must be URL-encoded: @ -> %40, # -> %23, : -> %3A, / -> %2F
HOSTIGER_DATABASE_URL="mysql://u415125152_Test:Test-Sample%40123@localhost:3306/ExporioDB?connection_limit=5&pool_timeout=20"

# --- Public site URL (used in emails, sitemap, SEO) ---
NEXT_PUBLIC_SITE_URL="https://exporioholidays.com"

# --- Gmail used to send verification / subscription emails (use a Google App Password) ---
EMAIL_USER="your-gmail@gmail.com"
EMAIL_PASSWORD="your-16-char-app-password"

# --- Where Contact Us alerts go (comma-separated). Leave empty to email every admin account ---
ADMIN_NOTIFICATION_EMAIL=""

# --- Hostinger FTP for image uploads (hPanel -> Files -> FTP Accounts) ---
FTP_HOST="ftp.your-domain.com"
FTP_PORT="21"
FTP_USER="your-ftp-user"
FTP_PASSWORD="your-ftp-password"
# Folder on the FTP account that uploads go into (created if missing).
# Images are stored as /media/<file> and served by the app itself.
FTP_UPLOAD_DIR="sample"

# --- First admin account (npm run db:seed) ---
VITE_ADMIN_EMAIL="admin@example.com"
VITE_ADMIN_PASSWORD="change-me-min-8-chars"

# --- Only for the one-time data copy (npm run db:migrate-from-supabase); remove afterwards ---
DIRECT_URL="postgresql://postgres:password@db.your-project.supabase.co:5432/postgres"

# ---- GitHub Pages (npm run deploy) ----
# Leave PAGES_API_URL empty for a standalone demo (data and images saved into the site, forms off).
# Once Hostinger is live, set it to that site so the Pages build uses its API, forms and images.
PAGES_API_URL=
# Set on Hostinger: sites allowed to call the public API (comma separated)
CORS_ORIGINS=https://craftmindai.github.io
